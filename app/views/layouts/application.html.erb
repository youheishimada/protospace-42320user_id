<!DOCTYPE html>
<html>
  <head>
    <title>Protospace</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/normalize/8.0.1/normalize.css">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
  </head>

  <body>
    <header class="header">
      <div class="inner nav">
        <div class="logo">
          <%= link_to image_tag("logo.png"), root_path %>
        </div>
        <div>
          <% if user_signed_in? %>
            <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "nav__logout", form: { style: "display:inline" } %>
             <%= link_to "New Proto", new_prototype_path, class: "nav__btn" %>
          <% else %>
            <%= link_to "ログイン", new_user_session_path, class: "nav__btn" %>
            <%= link_to "新規登録", new_user_registration_path, class: "nav__btn" %>
          <% end %>
        </div>
      </div>
    </header>

    <main>
      <%= yield %>

      <% if notice %>
  <p class="notice"><%= notice %></p>
<% end %>
<% if alert %>
  <p class="alert"><%= alert %></p>
<% end %>
    </main>

    <footer class="footer">
      <p class="copyright">© Protospace All rights reserved.</p>
    </footer>
  </body>

</html>
