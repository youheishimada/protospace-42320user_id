<h1 class="page-heading">新規プロトタイプ投稿</h1>

<%= form_with model: @prototype, local: true do |f| %>
  <% if @prototype.errors.any? %>
    <ul>
      <% @prototype.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <div class="field">
    <%= f.label :title, "プロトタイプの名称" %><br>
    <%= f.text_field :title %>
  </div>

  <div class="field">
    <%= f.label :catch_copy, "キャッチコピー" %><br>
    <%= f.text_area :catch_copy %>
  </div>

  <div class="field">
    <%= f.label :concept, "コンセプト" %><br>
    <%= f.text_area :concept %>
  </div>

  <div class="field">
    <%= f.label :image, "画像" %><br>
    <%= f.file_field :image %>
  </div>

  <div class="actions">
    <%= f.submit "投稿する", class: "form__btn" %>
  </div>
<% end %>