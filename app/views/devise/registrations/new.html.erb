<h2>新規登録</h2>

<%= form_with model: resource, url: registration_path(resource_name), local: true do |f| %>
  <% if resource.errors.any? %>
    <ul>
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <div class="field">
    <%= f.label :name, "ユーザー名" %><br>
    <%= f.text_field :name %>
  </div>

  <div class="field">
    <%= f.label :email %><br>
    <%= f.email_field :email %>
  </div>

  <div class="field">
    <%= f.label :profile, "プロフィール" %><br>
    <%= f.text_area :profile %>
  </div>

  <div class="field">
    <%= f.label :occupation, "所属" %><br>
    <%= f.text_area :occupation %>
  </div>

  <div class="field">
    <%= f.label :position, "役職" %><br>
    <%= f.text_area :position %>
  </div>

  <div class="actions">
    <%= f.submit "登録する" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
